{
  "name": "voxelcraft-lite",
  "version": "1.0.0",
  "description": "A Minecraft-inspired desktop sandbox game prototype with crafting and procedural generation.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [
    "minecraft",
    "voxel",
    "game",
    "desktop",
    "electron"
  ],
  "author": "Raptor-464",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.2",
    "electron-builder": "^24.13.4"
  },
  "build": {
    "appId": "com.raptor464.voxelcraftlite",
    "productName": "VoxelCraft Lite",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!**/.git/**",
      "!**/dist/**",
      "!**/node_modules/**"
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "mac": {
      "target": "dmg"
    }
  }
}
