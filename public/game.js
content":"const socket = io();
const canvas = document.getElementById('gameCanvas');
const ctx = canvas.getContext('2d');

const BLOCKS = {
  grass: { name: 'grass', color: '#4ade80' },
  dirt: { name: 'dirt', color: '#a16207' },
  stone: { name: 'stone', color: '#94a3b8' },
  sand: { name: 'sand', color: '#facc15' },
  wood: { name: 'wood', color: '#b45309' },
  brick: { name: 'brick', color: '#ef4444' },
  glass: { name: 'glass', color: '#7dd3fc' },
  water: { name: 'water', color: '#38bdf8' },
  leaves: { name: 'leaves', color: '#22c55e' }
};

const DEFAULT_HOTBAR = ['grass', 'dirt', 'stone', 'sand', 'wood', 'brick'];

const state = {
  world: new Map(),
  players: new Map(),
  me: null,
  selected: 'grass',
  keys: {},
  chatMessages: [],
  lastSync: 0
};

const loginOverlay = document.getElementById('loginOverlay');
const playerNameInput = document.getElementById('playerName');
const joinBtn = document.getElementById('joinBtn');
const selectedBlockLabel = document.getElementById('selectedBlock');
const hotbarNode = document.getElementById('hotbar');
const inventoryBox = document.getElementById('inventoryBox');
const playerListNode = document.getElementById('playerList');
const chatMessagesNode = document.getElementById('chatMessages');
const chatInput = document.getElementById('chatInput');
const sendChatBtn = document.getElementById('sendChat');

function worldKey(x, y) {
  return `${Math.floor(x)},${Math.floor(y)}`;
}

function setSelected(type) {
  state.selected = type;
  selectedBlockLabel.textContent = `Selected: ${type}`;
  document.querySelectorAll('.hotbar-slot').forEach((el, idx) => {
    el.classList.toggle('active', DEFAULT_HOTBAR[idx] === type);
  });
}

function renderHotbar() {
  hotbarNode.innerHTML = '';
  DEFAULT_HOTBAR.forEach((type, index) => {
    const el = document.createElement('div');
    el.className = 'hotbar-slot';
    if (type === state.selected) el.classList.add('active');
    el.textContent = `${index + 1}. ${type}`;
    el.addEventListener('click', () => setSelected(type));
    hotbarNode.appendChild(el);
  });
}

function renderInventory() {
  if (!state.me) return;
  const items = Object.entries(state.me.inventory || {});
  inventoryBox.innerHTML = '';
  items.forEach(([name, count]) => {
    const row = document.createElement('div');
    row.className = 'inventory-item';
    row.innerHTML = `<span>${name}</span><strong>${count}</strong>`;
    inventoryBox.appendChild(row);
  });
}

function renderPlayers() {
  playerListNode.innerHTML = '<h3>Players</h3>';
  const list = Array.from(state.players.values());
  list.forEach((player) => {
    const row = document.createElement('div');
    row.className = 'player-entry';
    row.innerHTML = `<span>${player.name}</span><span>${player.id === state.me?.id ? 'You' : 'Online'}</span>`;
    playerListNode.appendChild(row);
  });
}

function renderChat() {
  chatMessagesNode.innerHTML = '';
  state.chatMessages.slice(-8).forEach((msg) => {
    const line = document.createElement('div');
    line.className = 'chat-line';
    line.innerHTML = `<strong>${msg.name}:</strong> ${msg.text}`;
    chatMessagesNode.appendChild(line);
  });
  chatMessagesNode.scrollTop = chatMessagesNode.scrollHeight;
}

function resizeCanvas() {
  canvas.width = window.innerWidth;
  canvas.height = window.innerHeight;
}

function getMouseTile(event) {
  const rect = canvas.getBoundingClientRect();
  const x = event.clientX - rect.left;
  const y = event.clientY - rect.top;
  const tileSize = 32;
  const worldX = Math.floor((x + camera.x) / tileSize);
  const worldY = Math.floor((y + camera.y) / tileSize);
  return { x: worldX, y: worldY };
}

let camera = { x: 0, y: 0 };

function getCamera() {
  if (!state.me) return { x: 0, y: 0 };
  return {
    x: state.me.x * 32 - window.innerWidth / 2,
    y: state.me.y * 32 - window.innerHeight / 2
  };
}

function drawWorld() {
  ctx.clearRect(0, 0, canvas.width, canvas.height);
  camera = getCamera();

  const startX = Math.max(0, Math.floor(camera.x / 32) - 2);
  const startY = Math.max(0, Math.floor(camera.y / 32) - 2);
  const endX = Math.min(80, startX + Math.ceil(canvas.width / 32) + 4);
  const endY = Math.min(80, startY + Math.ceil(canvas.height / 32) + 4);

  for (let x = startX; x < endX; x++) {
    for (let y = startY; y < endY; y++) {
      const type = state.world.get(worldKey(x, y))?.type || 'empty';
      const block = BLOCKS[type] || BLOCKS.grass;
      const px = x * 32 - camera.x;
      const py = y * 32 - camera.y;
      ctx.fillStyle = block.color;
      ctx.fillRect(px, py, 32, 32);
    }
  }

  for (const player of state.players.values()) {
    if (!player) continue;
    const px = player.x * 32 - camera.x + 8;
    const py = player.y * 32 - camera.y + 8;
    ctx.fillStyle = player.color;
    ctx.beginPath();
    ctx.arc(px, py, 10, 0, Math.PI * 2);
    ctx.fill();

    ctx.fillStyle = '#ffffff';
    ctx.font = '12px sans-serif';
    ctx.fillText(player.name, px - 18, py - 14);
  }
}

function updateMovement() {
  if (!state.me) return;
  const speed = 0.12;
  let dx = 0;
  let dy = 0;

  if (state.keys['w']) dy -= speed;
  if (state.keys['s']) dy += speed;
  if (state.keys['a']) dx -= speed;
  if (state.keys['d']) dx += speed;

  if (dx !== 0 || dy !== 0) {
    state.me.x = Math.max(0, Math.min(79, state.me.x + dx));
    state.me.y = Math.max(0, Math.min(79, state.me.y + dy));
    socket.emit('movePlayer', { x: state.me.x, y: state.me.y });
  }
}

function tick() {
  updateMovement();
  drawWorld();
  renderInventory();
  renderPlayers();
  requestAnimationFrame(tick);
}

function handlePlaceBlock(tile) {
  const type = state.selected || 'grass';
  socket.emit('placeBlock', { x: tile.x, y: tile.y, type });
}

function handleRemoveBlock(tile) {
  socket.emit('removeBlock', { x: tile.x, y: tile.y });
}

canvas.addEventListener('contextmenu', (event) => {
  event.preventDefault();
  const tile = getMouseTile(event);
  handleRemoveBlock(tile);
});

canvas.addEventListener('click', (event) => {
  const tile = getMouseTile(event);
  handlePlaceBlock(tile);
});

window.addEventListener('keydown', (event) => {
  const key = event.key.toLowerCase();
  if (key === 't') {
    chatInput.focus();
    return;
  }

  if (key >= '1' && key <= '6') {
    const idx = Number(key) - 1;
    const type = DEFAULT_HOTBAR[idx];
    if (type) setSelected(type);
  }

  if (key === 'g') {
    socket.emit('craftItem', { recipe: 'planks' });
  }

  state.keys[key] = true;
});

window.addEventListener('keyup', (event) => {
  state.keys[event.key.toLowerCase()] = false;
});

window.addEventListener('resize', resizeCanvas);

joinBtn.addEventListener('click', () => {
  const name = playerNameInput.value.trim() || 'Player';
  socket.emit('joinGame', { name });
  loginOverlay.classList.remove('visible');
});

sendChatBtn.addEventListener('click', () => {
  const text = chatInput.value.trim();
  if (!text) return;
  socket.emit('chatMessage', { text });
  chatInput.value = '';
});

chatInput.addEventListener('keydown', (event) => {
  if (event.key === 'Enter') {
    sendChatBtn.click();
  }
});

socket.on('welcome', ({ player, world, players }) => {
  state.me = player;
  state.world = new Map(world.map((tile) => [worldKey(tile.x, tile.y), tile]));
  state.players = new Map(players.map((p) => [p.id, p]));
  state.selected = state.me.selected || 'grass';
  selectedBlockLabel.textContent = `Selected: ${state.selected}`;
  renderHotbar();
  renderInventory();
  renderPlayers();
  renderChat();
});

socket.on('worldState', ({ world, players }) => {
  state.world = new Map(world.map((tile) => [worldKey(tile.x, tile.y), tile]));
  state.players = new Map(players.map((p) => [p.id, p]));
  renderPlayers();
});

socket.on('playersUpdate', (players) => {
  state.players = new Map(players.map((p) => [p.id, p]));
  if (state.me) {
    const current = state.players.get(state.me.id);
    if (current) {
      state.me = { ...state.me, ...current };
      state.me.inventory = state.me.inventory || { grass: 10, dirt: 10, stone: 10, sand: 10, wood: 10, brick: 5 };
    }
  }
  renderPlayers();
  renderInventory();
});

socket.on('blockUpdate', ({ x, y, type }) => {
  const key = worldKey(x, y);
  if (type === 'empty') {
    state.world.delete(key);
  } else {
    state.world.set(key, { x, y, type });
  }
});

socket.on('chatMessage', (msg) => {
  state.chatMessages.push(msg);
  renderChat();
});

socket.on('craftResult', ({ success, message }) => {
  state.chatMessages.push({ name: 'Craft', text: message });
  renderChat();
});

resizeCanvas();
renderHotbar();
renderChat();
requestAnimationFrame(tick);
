content":"* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

:root {
  --bg: #0f172a;
  --panel: rgba(15, 23, 42, 0.82);
  --panel-border: rgba(148, 163, 184, 0.35);
  --text: #e2e8f0;
  --muted: #cbd5e1;
  --green: #22c55e;
  --gold: #fbbf24;
  --blue: #38bdf8;
}

html, body {
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #0b1120;
  color: var(--text);
  font-family: Arial, Helvetica, sans-serif;
}

body {
  position: relative;
}

canvas {
  display: block;
  width: 100vw;
  height: 100vh;
  background: linear-gradient(#7dd3fc 0%, #dbeafe 25%, #86efac 100%);
  cursor: crosshair;
}

.overlay {
  position: fixed;
  inset: 0;
  background: rgba(2, 6, 23, 0.8);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 200;
}

.overlay.visible {
  display: flex;
}

.panel {
  width: min(420px, 90vw);
  background: var(--panel);
  border: 1px solid var(--panel-border);
  border-radius: 16px;
  padding: 28px;
  box-shadow: 0 20px 35px rgba(0, 0, 0, 0.4);
  text-align: center;
}

.panel h1 {
  font-size: 2.1rem;
  margin-bottom: 10px;
  color: var(--gold);
}

.panel p {
  color: var(--muted);
  margin-bottom: 18px;
}

.panel input {
  width: 100%;
  padding: 12px 14px;
  border-radius: 10px;
  border: 1px solid var(--panel-border);
  background: rgba(15, 23, 42, 0.9);
  color: var(--text);
  font-size: 1rem;
  margin-bottom: 16px;
}

.panel button,
#sendChat {
  border: none;
  border-radius: 10px;
  background: linear-gradient(135deg, var(--green), #16a34a);
  color: white;
  padding: 12px 18px;
  font-weight: bold;
  cursor: pointer;
}

#hud {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 30;
}

#topBar,
#bottomLeft,
#playerList,
#chatPanel {
  position: absolute;
  background: rgba(15, 23, 42, 0.82);
  border: 1px solid var(--panel-border);
  border-radius: 12px;
  backdrop-filter: blur(4px);
}

#topBar {
  top: 18px;
  left: 18px;
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 12px 16px;
  pointer-events: auto;
}

#title {
  font-size: 1.5rem;
  font-weight: bold;
  color: var(--gold);
}

#selectedBlock {
  color: var(--muted);
  font-size: 0.95rem;
}

#hotbar {
  position: absolute;
  left: 50%;
  bottom: 18px;
  transform: translateX(-50%);
  display: flex;
  gap: 8px;
  padding: 10px 12px;
  border: 1px solid var(--panel-border);
  border-radius: 12px;
  background: rgba(15, 23, 42, 0.82);
  pointer-events: auto;
}

.hotbar-slot {
  min-width: 74px;
  padding: 10px 12px;
  border-radius: 8px;
  background: rgba(30, 41, 59, 0.9);
  border: 1px solid rgba(148, 163, 184, 0.35);
  text-align: center;
  color: var(--text);
  cursor: pointer;
  font-size: 0.8rem;
}

.hotbar-slot.active {
  border-color: var(--gold);
  box-shadow: 0 0 0 1px rgba(251, 191, 36, 0.7);
  background: rgba(251, 191, 36, 0.2);
}

#bottomLeft {
  left: 18px;
  bottom: 18px;
  min-width: 220px;
  padding: 12px;
  pointer-events: auto;
}

#inventoryBox {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  font-size: 0.8rem;
}

.inventory-item {
  display: flex;
  justify-content: space-between;
  gap: 6px;
  padding: 6px 8px;
  border-radius: 8px;
  background: rgba(30, 41, 59, 0.8);
  border: 1px solid rgba(148, 163, 184, 0.25);
}

#playerList {
  right: 18px;
  top: 74px;
  width: 220px;
  padding: 12px;
  pointer-events: auto;
}

#playerList h3 {
  margin-bottom: 8px;
  color: var(--green);
  font-size: 1rem;
}

.player-entry {
  display: flex;
  justify-content: space-between;
  margin: 6px 0;
  font-size: 0.85rem;
  color: var(--muted);
}

#chatPanel {
  right: 18px;
  bottom: 18px;
  width: 300px;
  padding: 10px;
  pointer-events: auto;
}

#chatMessages {
  min-height: 120px;
  max-height: 180px;
  overflow: auto;
  padding: 8px;
  background: rgba(15, 23, 42, 0.7);
  border-radius: 8px;
  font-size: 0.8rem;
  color: var(--muted);
}

.chat-line {
  margin-bottom: 6px;
  line-height: 1.3;
}

.chat-line strong {
  color: var(--green);
}

#chatInputRow {
  display: flex;
  gap: 8px;
  margin-top: 8px;
}

#chatInput {
  flex: 1;
  border-radius: 8px;
  border: 1px solid var(--panel-border);
  background: rgba(15, 23, 42, 0.8);
  color: var(--text);
  padding: 8px 10px;
}

@media (max-width: 700px) {
  #chatPanel {
    width: 200px;
  }

  #playerList {
    width: 170px;
  }

  #hotbar {
    bottom: 10px;
    gap: 6px;
  }

  .hotbar-slot {
    min-width: 58px;
    padding: 8px 6px;
    font-size: 0.72rem;
  }
}
