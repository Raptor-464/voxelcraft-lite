const express = require('express');
const http = require('http');
const path = require('path');
const { Server } = require('socket.io');
const { v4: uuidv4 } = require('uuid');

const app = express();
const server = http.createServer(app);
const io = new Server(server, { cors: { origin: '*' } });

const PORT = process.env.PORT || 3000;
const WORLD_SIZE = 80;
const HOTBAR = ['grass', 'dirt', 'stone', 'sand', 'wood', 'brick'];

const world = new Map();
const players = new Map();

function keyFor(x, y) {
  return `${Math.floor(x)},${Math.floor(y)}`;
}

function clamp(value, min, max) {
  return Math.min(Math.max(value, min), max);
}

function noiseTile(x, y) {
  const waveA = Math.sin(x * 0.42) * 2.4;
  const waveB = Math.cos(y * 0.38) * 2.1;
  const height = waveA + waveB + 2.2;

  if (height < 0.6) return 'water';
  if (height < 1.5) return 'sand';
  if (height < 2.8) return 'grass';
  return 'stone';
}

function generateWorld() {
  for (let x = 0; x < WORLD_SIZE; x++) {
    for (let y = 0; y < WORLD_SIZE; y++) {
      const type = noiseTile(x, y);
      const key = keyFor(x, y);

      if (type === 'water') {
        world.set(key, { x, y, type: 'water' });
        continue;
      }

      let tileType = type;
      if (Math.random() < 0.05 && type === 'grass') {
        tileType = 'wood';
        for (const [dx, dy] of [[0, 1], [1, 0], [-1, 0], [0, -1]]) {
          const nx = x + dx;
          const ny = y + dy;
          if (nx >= 0 && ny >= 0 && nx < WORLD_SIZE && ny < WORLD_SIZE) {
            world.set(keyFor(nx, ny), { x: nx, y: ny, type: 'leaves' });
          }
        }
      }

      world.set(key, { x, y, type: tileType });
    }
  }
}

function getWorldPayload() {
  return Array.from(world.values()).map(({ x, y, type }) => ({ x, y, type }));
}

function getPlayerPayload() {
  return Array.from(players.values()).map((p) => ({
    id: p.id,
    name: p.name,
    x: p.x,
    y: p.y,
    color: p.color,
    selected: p.selected,
    inventory: p.inventory
  }));
}

function createPlayer(socketId, name) {
  const player = {
    id: socketId,
    name: String(name || 'Player').slice(0, 16),
    x: 12 + Math.random() * 10,
    y: 12 + Math.random() * 10,
    color: `hsl(${Math.random() * 360}, 70%, 60%)`,
    selected: 'grass',
    inventory: {
      grass: 24,
      dirt: 24,
      stone: 24,
      sand: 12,
      wood: 12,
      brick: 6,
      glass: 3
    }
  };

  players.set(socketId, player);
  return player;
}

app.use(express.static(path.join(__dirname, 'public')));

app.get('/health', (_req, res) => {
  res.json({ ok: true, players: players.size, worldSize: WORLD_SIZE });
});

io.on('connection', (socket) => {
  console.log('connected:', socket.id);

  socket.on('joinGame', ({ name }) => {
    const player = createPlayer(socket.id, name);
    socket.emit('welcome', {
      player,
      world: getWorldPayload(),
      players: getPlayerPayload()
    });
    io.emit('playersUpdate', getPlayerPayload());
    io.emit('chatMessage', { name: 'System', text: `${player.name} joined the world.` });
  });

  socket.on('movePlayer', ({ x, y }) => {
    const player = players.get(socket.id);
    if (!player) return;
    player.x = clamp(Number(x) || player.x, 0, WORLD_SIZE - 1);
    player.y = clamp(Number(y) || player.y, 0, WORLD_SIZE - 1);
    io.emit('playersUpdate', getPlayerPayload());
  });

  socket.on('changeSelected', ({ type }) => {
    const player = players.get(socket.id);
    if (!player) return;
    if (HOTBAR.includes(type)) {
      player.selected = type;
      io.emit('playersUpdate', getPlayerPayload());
    }
  });

  socket.on('placeBlock', ({ x, y, type }) => {
    const player = players.get(socket.id);
    if (!player) return;

    const bx = Math.floor(Number(x));
    const by = Math.floor(Number(y));
    if (bx < 0 || by < 0 || bx >= WORLD_SIZE || by >= WORLD_SIZE) return;
    if (!player.inventory[type] || player.inventory[type] <= 0) return;

    const key = keyFor(bx, by);
    const current = world.get(key);
    if (current && current.type !== 'water') return;

    world.set(key, { x: bx, y: by, type });
    player.inventory[type] = Math.max(0, player.inventory[type] - 1);
    io.emit('blockUpdate', { x: bx, y: by, type });
    io.emit('playersUpdate', getPlayerPayload());
  });

  socket.on('removeBlock', ({ x, y }) => {
    const player = players.get(socket.id);
    if (!player) return;

    const bx = Math.floor(Number(x));
    const by = Math.floor(Number(y));
    if (bx < 0 || by < 0 || bx >= WORLD_SIZE || by >= WORLD_SIZE) return;

    const key = keyFor(bx, by);
    const current = world.get(key);
    if (!current || current.type === 'water') return;

    const reward = current.type;
    player.inventory[reward] = (player.inventory[reward] || 0) + 1;
    world.set(key, { x: bx, y: by, type: 'empty' });
    io.emit('blockUpdate', { x: bx, y: by, type: 'empty' });
    io.emit('playersUpdate', getPlayerPayload());
  });

  socket.on('craftItem', ({ recipe }) => {
    const player = players.get(socket.id);
    if (!player) return;

    const recipes = {
      planks: { wood: 2 },
      bricks: { stone: 2 },
      glass: { sand: 3 },
      stoneBrick: { brick: 2 }
    };

    const required = recipes[recipe];
    if (!required) return;

    const canCraft = Object.entries(required).every(([type, amount]) => (player.inventory[type] || 0) >= amount);
    if (!canCraft) {
      socket.emit('craftResult', { success: false, message: `Not enough materials for ${recipe}` });
      return;
    }

    Object.entries(required).forEach(([type, amount]) => {
      player.inventory[type] -= amount;
    });

    const outputMap = {
      planks: 'wood',
      bricks: 'brick',
      glass: 'glass',
      stoneBrick: 'stone'
    };

    const outputType = outputMap[recipe];
    player.inventory[outputType] = (player.inventory[outputType] || 0) + 1;
    socket.emit('craftResult', { success: true, message: `${recipe} crafted` });
    io.emit('playersUpdate', getPlayerPayload());
  });

  socket.on('chatMessage', ({ text }) => {
    const player = players.get(socket.id);
    if (!player) return;
    const safeText = String(text || '').slice(0, 100);
    io.emit('chatMessage', { name: player.name, text: safeText });
  });

  socket.on('disconnect', () => {
    const player = players.get(socket.id);
    if (player) {
      io.emit('chatMessage', { name: 'System', text: `${player.name} left the world.` });
    }
    players.delete(socket.id);
    io.emit('playersUpdate', getPlayerPayload());
  });
});

generateWorld();

server.listen(PORT, () => {
  console.log(`VoxelCraft server running on http://localhost:${PORT}`);
});
