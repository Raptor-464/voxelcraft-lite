const express = require('express');
const http = require('http');
const path = require('path');
const { Server } = require('socket.io');
const { v4: uuidv4 } = require('uuid');

const app = express();
const server = http.createServer(app);
const io = new Server(server, { cors: { origin: '*' } });

const PORT = process.env.PORT || 3000;
const WORLD_SIZE = 80;
const TILE_SIZE = 32;

const BLOCK_COLORS = {
  empty: '#000000',
  grass: '#4ade80',
  dirt: '#a16207',
  stone: '#94a3b8',
  sand: '#facc15',
  wood: '#b45309',
  brick: '#ef4444',
  glass: '#7dd3fc',
  water: '#38bdf8',
  leaves: '#22c55e'
};

const world = new Map();
const players = new Map();
const blockOrder = ['grass', 'dirt', 'stone', 'sand', 'wood', 'brick'];

function keyFor(x, y) {
  return `${x},${y}`;
}

function generateTerrainTile(x, y) {
  const waveA = Math.sin(x * 0.45) * 2.5;
  const waveB = Math.cos(y * 0.35) * 2.2;
  const height = waveA + waveB + 2.2;

  if (height < 0.5) return 'water';
  if (height < 1.5) return 'sand';
  if (height < 2.8) return 'grass';
  return 'stone';
}

function generateWorld() {
  for (let x = 0; x < WORLD_SIZE; x++) {
    for (let y = 0; y < WORLD_SIZE; y++) {
      const tile = generateTerrainTile(x, y);
      if (tile === 'water') {
        world.set(keyFor(x, y), { type: 'water', x, y });
        continue;
      }

      if (Math.random() < 0.06 && tile === 'grass') {
        world.set(keyFor(x, y), { type: 'wood', x, y });
        if (Math.random() < 0.55) {
          for (const [dx, dy] of [[0, 1], [1, 0], [-1, 0], [0, -1]]) {
            const nx = x + dx;
            const ny = y + dy;
            if (nx >= 0 && ny >= 0 && nx < WORLD_SIZE && ny < WORLD_SIZE) {
              world.set(keyFor(nx, ny), { type: 'leaves', x: nx, y: ny });
            }
          }
        }
      } else {
        world.set(keyFor(x, y), { type: tile, x, y });
      }
    }
  }
}

function getWorldSnapshot() {
  const snapshot = [];
  for (const tile of world.values()) {
    snapshot.push({ x: tile.x, y: tile.y, type: tile.type });
  }
  return snapshot;
}

function clamp(value, min, max) {
  return Math.min(Math.max(value, min), max);
}

function getPlayerList() {
  return Array.from(players.values()).map((p) => ({
    id: p.id,
    name: p.name,
    x: p.x,
    y: p.y,
    color: p.color,
    selected: p.selected
  }));
}

function broadcastState() {
  io.emit('worldState', { world: getWorldSnapshot(), players: getPlayerList() });
}

app.use(express.static(path.join(__dirname, 'public')));

io.on('connection', (socket) => {
  console.log('User connected:', socket.id);

  socket.on('joinGame', ({ name }) => {
    const safeName = String(name || 'Player').slice(0, 16) || 'Player';
    const spawnX = 10 + Math.random() * 12;
    const spawnY = 10 + Math.random() * 12;

    const player = {
      id: socket.id,
      name: safeName,
      x: spawnX,
      y: spawnY,
      color: `hsl(${Math.random() * 360}, 70%, 60%)`,
      selected: 'grass',
      inventory: {
        grass: 24,
        dirt: 24,
        stone: 24,
        sand: 12,
        wood: 12,
        brick: 6,
        glass: 4
      }
    };

    players.set(socket.id, player);
    socket.emit('welcome', {
      id: socket.id,
      player,
      world: getWorldSnapshot(),
      players: getPlayerList()
    });

    io.emit('playersUpdate', getPlayerList());
    io.emit('chatMessage', { name: 'System', text: `${safeName} joined the world!` });
  });

  socket.on('movePlayer', ({ x, y }) => {
    const player = players.get(socket.id);
    if (!player) return;

    player.x = clamp(Number(x) || player.x, 0, WORLD_SIZE - 1);
    player.y = clamp(Number(y) || player.y, 0, WORLD_SIZE - 1);
    io.emit('playersUpdate', getPlayerList());
  });

  socket.on('changeSelected', ({ type }) => {
    const player = players.get(socket.id);
    if (!player) return;
    if (blockOrder.includes(type)) {
      player.selected = type;
      io.emit('playersUpdate', getPlayerList());
    }
  });

  socket.on('placeBlock', ({ x, y, type }) => {
    const player = players.get(socket.id);
    if (!player) return;
    const bx = Math.floor(Number(x));
    const by = Math.floor(Number(y));

    if (bx < 0 || by < 0 || bx >= WORLD_SIZE || by >= WORLD_SIZE) return;
    if (!player.inventory[type] || player.inventory[type] <= 0) return;

    const key = keyFor(bx, by);
    const current = world.get(key);
    if (current && current.type !== 'empty' && current.type !== 'water') return;

    world.set(key, { type, x: bx, y: by });
    player.inventory[type] = Math.max(0, (player.inventory[type] || 0) - 1);
    io.emit('blockUpdate', { x: bx, y: by, type: type });
    io.emit('playersUpdate', getPlayerList());
  });

  socket.on('removeBlock', ({ x, y }) => {
    const player = players.get(socket.id);
    if (!player) return;
    const bx = Math.floor(Number(x));
    const by = Math.floor(Number(y));

    if (bx < 0 || by < 0 || bx >= WORLD_SIZE || by >= WORLD_SIZE) return;
    const key = keyFor(bx, by);
    const current = world.get(key);
    if (!current || current.type === 'empty' || current.type === 'water') return;

    const rewardType = current.type;
    player.inventory[rewardType] = (player.inventory[rewardType] || 0) + 1;
    world.set(key, { type: 'empty', x: bx, y: by });
    io.emit('blockUpdate', { x: bx, y: by, type: 'empty' });
    io.emit('playersUpdate', getPlayerList());
  });

  socket.on('craftItem', ({ recipe }) => {
    const player = players.get(socket.id);
    if (!player) return;

    const recipes = {
      planks: { wood: 2 },
      bricks: { stone: 2 },
      glass: { sand: 3 },
      stoneBrick: { brick: 2 }
    };

    const required = recipes[recipe];
    if (!required) return;

    const canCraft = Object.entries(required).every(([type, amount]) => (player.inventory[type] || 0) >= amount);
    if (!canCraft) {
      socket.emit('craftResult', { success: false, message: `Need more materials for ${recipe}` });
      return;
    }

    Object.entries(required).forEach(([type, amount]) => {
      player.inventory[type] -= amount;
    });

    const outputs = {
      planks: 'wood',
      bricks: 'brick',
      glass: 'glass',
      stoneBrick: 'stone'
    };

    const outputType = outputs[recipe];
    player.inventory[outputType] = (player.inventory[outputType] || 0) + 1;
    socket.emit('craftResult', { success: true, message: `${recipe} crafted successfully` });
    io.emit('playersUpdate', getPlayerList());
  });

  socket.on('chatMessage', ({ text }) => {
    const player = players.get(socket.id);
    if (!player) return;
    io.emit('chatMessage', { name: player.name, text: String(text || '').slice(0, 200) });
  });

  socket.on('disconnect', () => {
    const player = players.get(socket.id);
    if (player) {
      io.emit('chatMessage', { name: 'System', text: `${player.name} left the world.` });
    }
    players.delete(socket.id);
    io.emit('playersUpdate', getPlayerList());
  });
});

generateWorld();

app.get('/health', (_req, res) => {
  res.json({ status: 'ok', worldSize: WORLD_SIZE, players: players.size });
});

server.listen(PORT, () => {
  console.log(`VoxelCraft server running on http://localhost:${PORT}`);
});
